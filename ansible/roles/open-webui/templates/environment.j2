HF_HOME={{ open_webui_data_dir }}/cache/huggingface
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false
HTTP_PROXY={{ open_webui_proxy_url }}
HTTPS_PROXY={{ open_webui_proxy_url }}
http_proxy={{ open_webui_proxy_url }}
https_proxy={{ open_webui_proxy_url }}
NO_PROXY=localhost,127.0.0.1,::1
no_proxy=localhost,127.0.0.1,::1
UV_TORCH_BACKEND=cpu
