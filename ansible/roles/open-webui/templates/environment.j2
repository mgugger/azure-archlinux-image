WEBUI_URL=https://{{ open_webui_domain }}
WEBUI_ADMIN_EMAIL={{ open_webui_admin_email }}
WEBUI_AUTH=true
ENABLE_SIGNUP=false
ENABLE_OLLAMA_API=false
ENABLE_OPENAI_API=true
OPENAI_API_BASE_URL={{ open_webui_bifrost_url }}
