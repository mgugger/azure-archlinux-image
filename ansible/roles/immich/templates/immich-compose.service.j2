[Unit]
Description=Immich Podman Compose
Wants=network-online.target
After=network-online.target {{ immich_media_service }}
Requires={{ immich_media_service }}

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ immich_compose_dir }}
Environment="PODMAN_COMPOSE_PROVIDER=/usr/bin/podman-compose"
Environment="HTTP_PROXY={{ immich_host_proxy_url }}"
Environment="HTTPS_PROXY={{ immich_host_proxy_url }}"
ExecStartPre=/usr/bin/mountpoint -q {{ immich_media_mount }}
ExecStart=/usr/bin/podman compose up -d
ExecStop=/usr/bin/podman compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
